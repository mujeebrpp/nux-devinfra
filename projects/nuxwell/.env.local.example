# NuxWell local development
NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3090
NEXT_PUBLIC_API_URL=http://localhost:3091
API_PORT=3091

# Shared dev PostgreSQL (docker-compose service: nux-dev-postgres).
# The host port comes from POSTGRES_PORT in the infrastructure .env (5433 on this machine).
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/nuxwell_dev

# Managed Better Auth (Neon) - development environment only.
# Create a Neon project, enable Auth on its development branch, then paste the Auth URL.
# Generate a cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Local email testing (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@nuxwell.local
