# NuxWell automated tests
NODE_ENV=test

NEXT_PUBLIC_APP_URL=http://localhost:3090
NEXT_PUBLIC_API_URL=http://localhost:3091
API_PORT=3091

# Isolated test PostgreSQL (docker-compose service: nux-dev-postgres).
# The host port comes from POSTGRES_PORT in the infrastructure .env (5433 on this machine).
# Jest and Playwright must only ever use this database - never nuxwell_dev.
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/nuxwell_test

# Dedicated Neon Auth development/test environment (optional for local test runs)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=test@nuxwell.local
