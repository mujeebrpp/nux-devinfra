generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

/// Local user profile. `authSubjectId` links to the Neon Auth subject
/// once Managed Better Auth is enabled (see docs/setup.md).
model User {
  id            String    @id @default(cuid())
  authSubjectId String?   @unique
  email         String    @unique
  fullName      String
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]

  @@map("users")
}

enum FacilityType {
  GYM
  YOGA_STUDIO
  POOL
  SAUNA
  COURT
}

model Facility {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  type      FacilityType
  location  String
  capacity  Int
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  services Service[]
  bookings Booking[]

  @@map("facilities")
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String

  bookings Booking[]

  @@index([facilityId])
  @@map("services")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model MembershipPlan {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String?
  priceCents   Int
  billingCycle BillingCycle
  benefits     Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("membership_plans")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id         String        @id @default(cuid())
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  userId     String
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String

  @@index([userId])
  @@index([facilityId, startsAt])
  @@map("bookings")
}
