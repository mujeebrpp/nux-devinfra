// NuxFarm — core domain schema (PostgreSQL)
// New-version plan phase 1: multi-location farms, crop cycles,
// task timelines, irrigation logs, inventory, and reports.
//
// Deliberately absent: EC/pH and nutrient targets or readings.
// No agronomic chemical values are stored or seeded by this app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycles  CropCycle[]
  tasks   Task[]      @relation("TaskAssignee")
  reports Report[]
}

model Farm {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  timezone    String   @default("UTC")
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations      FarmLocation[]
  cycles         CropCycle[]
  tasks          Task[]
  irrigationLogs IrrigationLog[]
  inventory      InventoryItem[]
  reports        Report[]

  @@index([active])
}

model FarmLocation {
  id          String   @id @default(uuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name        String
  code        String
  kind        String   @default("FIELD") // FIELD | GREENHOUSE | HIGH_TUNNEL | SHADE_HOUSE | NURSERY | STORAGE | OTHER
  areaSqm     Float?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycles         CropCycle[]
  tasks          Task[]
  irrigationLogs IrrigationLog[]
  inventory      InventoryItem[]

  @@unique([farmId, code])
  @@index([farmId])
}

model CropCycle {
  id              String       @id @default(uuid())
  farmId          String
  farm            Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  locationId      String
  location        FarmLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name            String
  crop            String
  variety         String?
  status          String       @default("PLANNED") // PLANNED | ACTIVE | COMPLETED | ABANDONED
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  plantingMethod  String?
  notes           String?
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stages         CycleStage[]
  tasks          Task[]
  irrigationLogs IrrigationLog[]

  @@index([farmId])
  @@index([locationId])
  @@index([status])
}

model CycleStage {
  id               String    @id @default(uuid())
  cycleId          String
  cycle            CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name             String
  sequence         Int
  status           String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | SKIPPED
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([cycleId])
}

model Task {
  id          String       @id @default(uuid())
  farmId      String
  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  locationId  String?
  location    FarmLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  cycleId     String?
  cycle       CropCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  status      String       @default("TODO") // TODO | IN_PROGRESS | DONE | BLOCKED | SKIPPED
  priority    String       @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([farmId, status])
  @@index([dueDate])
  @@index([cycleId])
}

model IrrigationLog {
  id              String       @id @default(uuid())
  farmId          String
  farm            Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  locationId      String?
  location        FarmLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  cycleId         String?
  cycle           CropCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  irrigatedAt     DateTime
  method          String       @default("MANUAL") // DRIP | SPRINKLER | FLOOD | MANUAL | OTHER
  durationMinutes Float?
  volumeLiters    Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([farmId, irrigatedAt])
  @@index([cycleId])
}

model InventoryItem {
  id           String              @id @default(uuid())
  farmId       String
  farm         Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  locationId   String?
  location     FarmLocation?       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  category     String              @default("OTHER") // SEED | SUBSTRATE | TOOL | PACKAGING | CHEMICAL | OTHER
  unit         String              @default("pcs")
  quantity     Float               @default(0)
  minQuantity  Float?
  unitCost     Float?
  notes        String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions InventoryTransaction[]

  @@unique([farmId, sku])
  @@index([farmId])
}

model InventoryTransaction {
  id            String         @id @default(uuid())
  itemId        String
  item          InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String // IN | OUT | ADJUST
  quantity      Float // signed for ADJUST
  balanceAfter  Float
  transactionAt DateTime       @default(now())
  reference     String?
  notes         String?

  @@index([itemId])
}

model Report {
  id            String   @id @default(uuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  type          String // OPERATIONS_OVERVIEW | CROP_CYCLE_SUMMARY | TASK_SUMMARY | IRRIGATION_SUMMARY | INVENTORY_SUMMARY
  title         String
  periodStart   DateTime?
  periodEnd     DateTime?
  filtersJson   String?
  dataJson      String
  generatedById String?
  generatedBy   User?    @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime @default(now())

  @@index([farmId, type])
}
